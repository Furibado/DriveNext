<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="@color/brand_dark" android:textSize="24sp"
            android:gravity="start" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/splash_slogan" android:textColor="@color/brand_dark" android:textSize="14sp"
            android:gravity="start" />
        <ImageView android:layout_width="match_parent" android:layout_height="240dp"
            android:layout_weight="1" android:scaleType="fitCenter"
            android:contentDescription="@null" android:src="@drawable/splash_logo" />
        <com.google.android.material.button.MaterialButton
            
            android:id="@+id/openLogin" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="@string/sign_in" android:textColor="@color/white"
            android:backgroundTint="@color/auth_button_fill" app:cornerRadius="8dp" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:id="@+id/openRegistration" android:layout_width="match_parent" android:layout_height="56dp"
            android:text="@string/sign_up" android:textColor="@color/brand_dark"
             app:cornerRadius="8dp" />
    </LinearLayout>
</ScrollView>
