            <com.google.android.material.button.MaterialButton android:id="@+id/details" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:layout_marginStart="12dp" android:paddingHorizontal="4dp" android:insetTop="4dp" android:insetBottom="4dp" android:text="@string/catalog_details" android:textColor="#1A1A1A" android:textSize="12sp" android:textAllCaps="false" app:cornerRadius="6dp" app:backgroundTint="@color/white" app:strokeColor="@color/brand_dark"/>
        </LinearLayout>
