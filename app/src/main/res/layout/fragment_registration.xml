<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/white" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="24dp" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center" android:layout_marginHorizontal="48dp"
                android:gravity="center" android:textStyle="bold" android:textSize="17sp"
                android:textColor="@color/brand_dark" />
            <ImageButton android:id="@+id/back" android:layout_width="48dp" android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Назад"
                android:src="@drawable/ic_auth_back" />
        </FrameLayout>
        <LinearLayout android:id="@+id/account" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Электронная почта" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/email" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" >
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/email" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textEmailAddress"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Пароль" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/password" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" app:endIconMode="password_toggle">
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/password" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textPassword" android:saveEnabled="false" />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Подтвердите пароль" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/confirmation" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" app:endIconMode="password_toggle">
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/confirmation" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textPassword" android:saveEnabled="false" />
</com.google.android.material.textfield.TextInputLayout>
<CheckBox android:id="@+id/consent" android:layout_width="match_parent" android:layout_height="wrap_content"
              android:text="Я согласен с условиями использования и политикой конфиденциальности" />
</LinearLayout>
        <LinearLayout android:id="@+id/profile" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Фамилия" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/surname" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" >
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/surname" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textPersonName"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Имя" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/givenName" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" >
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/givenName" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textPersonName"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Отчество (необязательно)" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/patronymic" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" >
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/patronymic" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="textPersonName"  />
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Дата рождения (MM/DD/YYYY)" android:textSize="13sp" android:textColor="@color/brand_dark" android:labelFor="@id/birthDate" />
<com.google.android.material.textfield.TextInputLayout style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginTop="4dp" app:hintEnabled="false" >
<com.google.android.material.textfield.TextInputEditText
        android:id="@+id/birthDate" android:layout_width="match_parent" android:layout_height="48dp"
        android:textSize="14sp" android:inputType="none" android:focusable="false" android:clickable="true" android:drawableEnd="@drawable/ic_auth_calendar" />
</com.google.android.material.textfield.TextInputLayout>
<RadioGroup android:id="@+id/gender" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
              <RadioButton android:id="@+id/male" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Мужской" />
              <RadioButton android:id="@+id/female" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Женский" />
          </RadioGroup>
</LinearLayout>
        <LinearLayout android:id="@+id/documents" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <FrameLayout android:layout_width="120dp" android:layout_height="120dp"
                android:layout_gravity="center" android:layout_marginTop="12dp">
                <ImageView android:id="@+id/avatarPreview" android:layout_width="108dp" android:layout_height="108dp"
                    android:layout_gravity="center" android:scaleType="centerInside" android:clipToOutline="true"
                    android:background="@drawable/bg_registration_avatar" android:contentDescription="Фото профиля"
                    android:src="@drawable/ic_auth_avatar_layer" />
                <FrameLayout android:id="@+id/avatar" android:layout_width="48dp" android:layout_height="48dp"
                    android:layout_gravity="bottom|end" android:clickable="true" android:focusable="true"
                    android:contentDescription="Добавить фото профиля">
                    <TextView android:layout_width="24dp" android:layout_height="24dp"
                        android:layout_gravity="center" android:background="@drawable/bg_registration_plus"
                        android:gravity="center" android:text="+" android:textColor="@color/white" />
                </FrameLayout>
            </FrameLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Добавление фотографии поможет владельцам автомобилей узнать вас при встрече." android:textColor="@color/brand_dark" android:textSize="13sp"  />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Номер водительского удостоверения" android:textColor="@color/brand_dark" android:textSize="13sp" android:layout_marginTop="12dp" android:labelFor="@id/licenseNumber" />
            <EditText android:id="@+id/licenseNumber" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="4dp" android:background="@drawable/bg_registration_field"
                android:paddingHorizontal="12dp" android:hint="0000000000" android:inputType="number"
                android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/text_secondary" android:maxLength="10" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Дата выдачи" android:textColor="@color/brand_dark" android:textSize="13sp" android:layout_marginTop="12dp" android:labelFor="@id/issueDate" />
            <EditText android:id="@+id/issueDate" android:layout_width="match_parent" android:layout_height="48dp"
                android:layout_marginTop="4dp" android:background="@drawable/bg_registration_field"
                android:paddingHorizontal="12dp" android:hint="ДД/ММ/ГГГГ" android:inputType="none"
                android:textSize="14sp" android:textColor="@color/black" android:textColorHint="@color/text_secondary" android:focusable="false" android:clickable="true" android:drawableStart="@drawable/ic_auth_calendar" android:drawablePadding="8dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Загрузите фото водительского удостоверения" android:textColor="@color/brand_dark" android:textSize="13sp" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/license"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:text="Загрузить фото" android:textColor="@color/brand_dark"
                app:icon="@drawable/ic_auth_upload" app:iconTint="@null" app:iconSize="40dp" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Загрузите фото паспорта" android:textColor="@color/brand_dark" android:textSize="13sp" android:layout_marginTop="12dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/passport"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content" android:layout_height="56dp"
                android:text="Загрузить фото" android:textColor="@color/brand_dark"
                app:icon="@drawable/ic_auth_upload" app:iconTint="@null" app:iconSize="40dp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/success" android:layout_width="match_parent"
    android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:orientation="vertical" android:visibility="gone">
    <ImageView android:layout_width="96dp" android:layout_height="96dp"
              android:layout_gravity="center"
              android:contentDescription="@null" android:src="@drawable/ic_auth_check_circle" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:layout_marginTop="24dp" android:gravity="center" android:text="Поздравляем"
              android:textColor="@color/brand_dark" android:textStyle="bold" android:textSize="20sp" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
              android:gravity="center" android:padding="16dp"
              android:text="@string/registration_success" />
</LinearLayout>
        <Space android:id="@+id/documentsSpacer" android:layout_width="1dp"
            android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />
        <TextView android:id="@+id/validationHint" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textColor="#B3261E" android:textSize="12sp"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/registrationProgress" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_gravity="center" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/next" app:cornerRadius="8dp"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:text="Далее" android:layout_marginTop="24dp" android:backgroundTint="@color/auth_button_fill" android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
