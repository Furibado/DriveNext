 <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EDEDED"/><TextView android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:text="@string/profile_logout" android:textColor="@color/brand_dark" android:textSize="14sp" android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true"/>
