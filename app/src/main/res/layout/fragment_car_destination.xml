<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/white" android:orientation="vertical" android:padding="24dp">
    <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/catalog_back"/>
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:textColor="@color/brand_dark" android:textSize="22sp" android:fontFamily="@font/montserrat_semibold"/>
    <TextView android:id="@+id/carName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textColor="@color/brand_dark" android:textSize="18sp"/>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/feature_not_ready" android:textColor="@color/text_secondary" android:textSize="16sp"/>
</LinearLayout>
